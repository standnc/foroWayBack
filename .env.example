# Copiar a .env y rellenar. NUNCA commitear .env (está en .gitignore).

# ─── Core ────────────────────────────────────────────────────────────────
# Obligatoria si DEBUG=False: los settings se niegan a cargar sin ella.
# Generar con: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Base de datos ───────────────────────────────────────────────────────
# Sin estas variables se usa SQLite en db.sqlite3 (suficiente en local).
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=foroboombang
# DB_USER=
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# ─── Verificación de email ───────────────────────────────────────────────
# "none" en local (sin SMTP). En producción SIEMPRE "mandatory": el gate de
# contenido exige User.is_verified, que solo se activa con la señal
# email_confirmed. Con "none" allauth no envía el email, la señal nunca se
# dispara y los usuarios quedan bloqueados sin salida. Ver ERRORES.md #43.
ACCOUNT_EMAIL_VERIFICATION=none

# ─── Email (SMTP con Resend) ─────────────────────────────────────────────
# En local se deja el backend de consola.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=noreply@clashbang.forum

# ─── Cloudflare R2 (estáticos y media) ───────────────────────────────────
# Con USE_R2=False se sirven desde disco. Definir la variable UNA sola vez:
# un .env con la clave duplicada usa la última y es una trampa. Ver ERRORES.md #43.
USE_R2=False
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=foroboombang-static
# R2_ENDPOINT_URL=
# R2_CUSTOM_DOMAIN=static.clashbang.forum

# ─── Logging ─────────────────────────────────────────────────────────────
# Por defecto: logs/ en local, /var/log/django con DEBUG=False.
# LOG_DIR=
