<!DOCTYPE html>
{% load static %}
<html lang="es" class="dark" data-theme="dark">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Foro Retro BoomBang — Revive la comunidad del juego más colorido">
    <meta name="theme-color" content="#0f172a">

    <title>{% block title %}Foro Retro BoomBang{% endblock %}</title>

    {# Tailwind #}
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              boom: {
                50:  "#ecfdf8", 100: "#d1fae8", 200: "#a7f0d2",
                300: "#6ee4b7", 400: "#34d099", 500: "#00d4aa",
                600: "#00a88a", 700: "#00846e", 800: "#006a59",
                900: "#005748", DEFAULT: "#00d4aa",
              },
              coral: {
                50:  "#fff7ed", 100: "#ffedd5", 200: "#fed7aa",
                300: "#fdba74", 400: "#fb923c", 500: "#ff6b35",
                600: "#ea580c", 700: "#c2410c", 800: "#9a3412",
                900: "#7c2d12", DEFAULT: "#ff6b35",
              },
              gold: {
                DEFAULT: "#ffd700", 50: "#fffbe6", 100: "#fff3b0",
                200: "#ffea80", 300: "#ffe04d", 400: "#ffd700",
                500: "#e6c200", 600: "#b39a00",
              },
              retro: {
                dark:  "#0b1120",
                card:  "#111827",
                card2: "#1a2332",
                border:"#1e293b",
              },
            },
            fontFamily: {
              display: [Fredoka, "system-ui", "sans-serif"],
              body:    [Inter, "system-ui", "sans-serif"],
            },
            backgroundImage: {
              "gradient-radial": "radial-gradient(var(--tw-gradient-stops))",
            },
          },
        },
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    {# Alpine + HTMX #}
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/htmx.org@2.x.x/dist/htmx.min.js"></script>

    {% block extra_head %}{% endblock %}
  </head>

  <body class="bg-[#060a16] text-slate-100 font-body antialiased min-h-screen flex flex-col"
        x-data="{ theme: dark, mobileNavOpen: false, scrolled: false }"
        @scroll.window="scrolled = window.scrollY > 20"
        :class="{ dark: theme === dark }">

    {# Skip link #}
    <a href="#main-content"
       class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2 focus:bg-boom focus:text-slate-900 focus:rounded-lg focus:outline-none focus:ring-2 focus:ring-boom/50">
      Saltar al contenido principal
    </a>

    {# === BACKDROP GRADIENT DECORATION === #}
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
      <div class="absolute -top-40 -right-40 w-[600px] h-[600px] rounded-full bg-gradient-radial from-boom/8 to-transparent opacity-80"></div>
      <div class="absolute -bottom-40 -left-40 w-[500px] h-[500px] rounded-full bg-gradient-radial from-coral/8 to-transparent opacity-60"></div>
      <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[400px] h-[400px] rounded-full bg-gradient-radial from-gold/6 to-transparent opacity-50"></div>
    </div>

    {# === NAVBAR === #}
    <header class="relative z-40 border-b"
            :class="scrolled ? bg-retro-dark/90 backdrop-blur-xl border-slate-700/60 : bg-retro-dark/60 border-transparent">
      <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between"
           aria-label="Navegación principal">
        {# Logo #}
        <a href="/" class="flex items-center gap-2 group" aria-label="Foro Retro BoomBang - Inicio">
          <span class="text-2xl" aria-hidden="true">🏝️</span>
          <span class="font-display text-xl font-bold">
            <span class="text-white group-hover:text-boom transition-colors">ClashBang</span>
            <span class="text-boom">Forum</span>
          </span>
        </a>

        {# Nav links (desktop) #}
        <div class="hidden md:flex items-center gap-6">
          <a href="/"
             class="text-sm font-medium transition-colors relative py-1
                    {% if request.path == '/' %}text-boom after:absolute after:bottom-0 after:left-0 after:right-0 after:h-0.5 after:bg-boom after:rounded-full
                    {% else %}text-slate-200 hover:text-boom{% endif %}">
            Inicio
          </a>
          <a href="{% url 'forum:categorias' %}"
             class="text-sm font-medium text-slate-200 hover:text-boom transition-colors">
            Categorías
          </a>
          <a href="{% url 'forum:buscar' %}"
             class="text-sm font-medium text-slate-200 hover:text-boom transition-colors">
            Buscar
          </a>
        </div>

        {# Right side #}
        <div class="flex items-center gap-2">
          {# Theme toggle #}
          <button @click="theme = theme === dark ? light : dark"
                  class="p-2 rounded-lg text-slate-300 hover:text-coral hover:bg-slate-800/80 transition-colors"
                  aria-label="Cambiar tema">
            <svg x-show="theme === dark" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
            </svg>
            <svg x-show="theme === light" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="display: none;">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
            </svg>
          </button>

          {# Mobile menu #}
          <button @click="mobileNavOpen = !mobileNavOpen"
                  class="md:hidden p-2 rounded-lg text-slate-300 hover:text-coral hover:bg-slate-800/80 transition-colors"
                  :aria-expanded="mobileNavOpen.toString()"
                  aria-label="Abrir menú">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path x-show="!mobileNavOpen" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
              <path x-show="mobileNavOpen" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" style="display: none"/>
            </svg>
          </button>

          {# Auth button #}
